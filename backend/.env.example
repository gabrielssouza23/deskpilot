# SQLite works out of the box; use PostgreSQL in production:
# DATABASE_URL=postgresql+psycopg://deskpilot:deskpilot@localhost:5432/deskpilot
DATABASE_URL=sqlite:///./deskpilot.db

# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=change-me

# Comma-separated list of origins allowed to call the API directly
CORS_ORIGINS=http://localhost:3000

# "auto" uses Claude when ANTHROPIC_API_KEY is set and falls back to rules otherwise
AI_PROVIDER=auto
ANTHROPIC_API_KEY=

# Creates a demo agent and sample tickets when the database is empty
SEED_DEMO_DATA=true
